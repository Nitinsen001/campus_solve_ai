{
  "version": 2,
  "builds": [
    {
      "src": "campus_solve_ai/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "python campus_solve_ai/manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "campus_solve_ai/wsgi.py"
    }
  ]
}